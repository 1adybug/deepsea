{
    "name": "@1adybug/tanstack-query",
    "version": "0.0.17",
    "description": "Typed factories for reusable TanStack Query query and mutation hooks.",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "sideEffects": false,
    "scripts": {
        "dev": "pnpm run build",
        "build": "rslib build",
        "prebuild": "node scripts/export.ts",
        "prepublishOnly": "pnpm run typecheck && pnpm run build",
        "typecheck": "tsc --noEmit",
        "clean": "node ../../scripts/clean.mjs",
        "test": "vitest run --config ../../vitest.config.ts",
        "test:types": "tsc --project tsconfig.test.json",
        "test:coverage": "vitest run --config ../../vitest.config.ts --coverage"
    },
    "keywords": [],
    "authors": [
        "lurongv@qq.com"
    ],
    "license": "MIT",
    "files": [
        "dist",
        "src",
        "README.zh-CN.md"
    ],
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/1adybug/deepsea.git",
        "directory": "packages/tanstack-query"
    },
    "homepage": "https://github.com/1adybug/deepsea/tree/main/packages/tanstack-query",
    "devDependencies": {
        "typescript": "catalog:",
        "@1adybug/build-config": "workspace:*",
        "@1adybug/typescript-config": "workspace:*",
        "@rslib/core": "catalog:",
        "vitest": "catalog:",
        "@testing-library/react": "catalog:",
        "@testing-library/dom": "catalog:",
        "jsdom": "catalog:"
    },
    "peerDependencies": {
        "@tanstack/react-query": "catalog:",
        "@types/react": "catalog:",
        "react": "catalog:"
    },
    "dependencies": {
        "@1adybug/types": "workspace:*"
    }
}
