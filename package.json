{
    "name": "@1adybug/deepsea",
    "version": "1.0.0",
    "description": "Deepsea JavaScript and TypeScript libraries, shared tooling and playground",
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "turbo watch dev --filter=@1adybug/playground... --concurrency=4",
        "dev:all": "turbo watch dev --concurrency=4",
        "build": "turbo run build --concurrency=4",
        "build:packages": "turbo run build --filter=./packages/* --filter=./compat/* --concurrency=4",
        "typecheck": "turbo run typecheck --concurrency=4",
        "lint": "eslint . --max-warnings=0",
        "test": "turbo run test --concurrency=4",
        "test:coverage": "turbo run test:coverage --concurrency=4",
        "check:workspace": "node scripts/check-workspace.mjs",
        "check:docs": "node scripts/check-docs.mjs",
        "format:check": "prettier --check .",
        "format": "prettier --write .",
        "check": "pnpm check:workspace && pnpm check:docs && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:types && pnpm test && pnpm build && pnpm check:artifacts",
        "clean": "turbo run clean",
        "changeset": "changeset",
        "version:packages": "changeset version && pnpm install --lockfile-only",
        "release": "pnpm check && changeset publish",
        "sync:registry": "node scripts/syncPackage.mjs",
        "prepare": "husky",
        "test:types": "turbo run test:types --concurrency=4",
        "check:artifacts": "node scripts/check-artifacts.mjs"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "devDependencies": {
        "@1adybug/eslint": "catalog:",
        "@1adybug/prettier": "catalog:",
        "@changesets/cli": "catalog:",
        "@eslint/js": "catalog:",
        "@types/node": "catalog:",
        "eslint": "catalog:",
        "eslint-plugin-react-hooks": "catalog:",
        "eslint-plugin-react-refresh": "catalog:",
        "globals": "catalog:",
        "husky": "catalog:",
        "lint-staged": "catalog:",
        "prettier": "catalog:",
        "typescript": "catalog:",
        "typescript-eslint": "catalog:",
        "turbo": "catalog:",
        "vitest": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "@testing-library/react": "catalog:",
        "@testing-library/dom": "catalog:",
        "jsdom": "catalog:"
    },
    "lint-staged": {
        "**/*": "prettier --write --ignore-unknown"
    },
    "packageManager": "pnpm@11.10.0",
    "engines": {
        "node": ">=24.15.0 <25",
        "pnpm": "11.10.0"
    }
}
